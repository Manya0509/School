@page "/ClassModel"
@inherits ClassPageViewModel
<h3>Классы и ученики</h3>

    <table class="table table-striped">

        <table class="table table-striped table-bordered">
            <thead class="table">
                <tr>
                    <th>Id класса</th>
                    <th>Номер класса</th>
                    @* <th>ID</th>
                    <th>Фамилия</th>
                    <th>Имя</th>
                    <th>Отчество</th>
                    <th>Возраст</th> *@
                </tr>
            </thead>
            <tbody>
            @foreach (var classItem in Classes)
            {
                <tr>
                    <td>@classItem.Id</td>
                    <td>@classItem.Number</td>
                </tr>
                
            }
            @* @foreach (var student in classItem.Students)
                {
                    <tr>
                    <td>@student.Id</td>
                    <td>@student.LastName</td>
                    <td>@student.FirstName</td>
                    <td>@student.MiddleName</td>
                    <td>@student.Age</td>
                    </tr>
                 } *@
            </tbody>
        </table>
    </table>



