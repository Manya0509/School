@using School.Web.PageModels.Classes

<MatDialog IsOpen="@ViewModel.IsOpenDialog" CanBeClosed="false">
    <MatDialogTitle class="diHeader">
        <h4>Подтверждение удаления</h4>
    </MatDialogTitle>
    <MatDialogContent>
        @if (ViewModel.ClassDelete != null)
        {
            @if (ViewModel.HasStudents)
            {
                <h5>Невозможно удалить класс!</h5>
                <p>Класс содержит студентов.</p>
            }
            else
            {
                <h5>Вы уверены, что хотите удалить класс: </h5>
            }
        }
    </MatDialogContent>
    <MatDialogActions>
        <button class="btn btn-danger" @onclick="@(() => ConfirmDelete.InvokeAsync(true))">Да, удалить</button>
        <button class="btn btn-secondary" @onclick="@(() => ConfirmDelete.InvokeAsync(false))">@(ViewModel.HasStudents ? "Закрыть" : "Отмена")</button>
    </MatDialogActions>
</MatDialog>

@code {
    [Parameter] public DeleteClassModel ViewModel { get; set; }
    [Parameter] public EventCallback<bool> ConfirmDelete { get; set; }
}