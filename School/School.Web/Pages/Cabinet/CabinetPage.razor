@page "/Cabinet"
@inherits CabinetPageViewModel

<button class="btn btn-outline-primary btn-sm mb-3 bi bi-search"
        @onclick="ToggleFilters">
</button>

@if (ShowFilters)
{
    <div class="mb-3 p-3 border rounded">
        <div class="row">
            <div class="col-md-4">
                <label>Номер кабинета:</label>
                <InputText @bind-Value="@FilterCabinet.Number" Class="form-control form-control-sm col-9" id="Number" title="Номер"></InputText>
            </div>
            <div class="col-md-4">
                <label>Преподаватель:</label>
                <InputText @bind-Value="@FilterCabinet.TeacherName" 
                            Class="form-control form-control-sm" id="TeacherName" title="Преподаватель"></InputText>
            </div>
            <div class="col-md-4">
                <label>Преподаватель:</label>
                <InputSelect @bind-Value="@FilterCabinet.TeacherId" Class="form-control form-control-sm">
                    <option value="">Все преподаватели</option>
                    @if (FilterCabinet.Teachers != null)
                    {
                        @foreach (var item in FilterCabinet.Teachers)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    }
                </InputSelect>
            </div>
    </div>
        <div class="mt-2">
            <button class="btn btn-primary btn-sm" @onclick="Search">
                Поиск
            </button>
            <button class="btn btn-secondary btn-sm ms-2" @onclick="ResetFilter">
                Сброс фильтра
            </button>
        </div>
    </div>
}

<div class="d-flex justify-content-end">
    <button type="button" class="btn-close" aria-label="Close"></button>
</div>

<h3>Кабинеты</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Номер кабинета</th>
            <th>Учитель</th>
            <th>Предмет</th>
            <th>Изменение</th>
            <th>Удаление</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cabinet in Cabinets)
        {
            <tr>
                <td>@cabinet.Id</td>
                <td>@cabinet.Number</td>
                <td>@cabinet.TeacherFullName</td>
                <td>@(cabinet.Teacher?.SubjectName ?? "Не указан")</td>
                <td>
                    <button class="btn btn-outline-secondary"
                            @onclick="@(() => SelectCabinet(cabinet))"
                            title="Изменить">
                        <i class="bi bi-pencil"></i>
                    </button>
                </td>
                <td>
                    @if (cabinet.IsDeleted)
                    {
                        <div class="d-flex gap-1">
                            <button class="btn btn-outline-success btn-sm"
                                    @onclick="@(() => DeleteAction(cabinet, false))"
                                    title="Восстановить">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm"
                                    @onclick="@(() => DeleteCabinet(cabinet))"
                                    title="Удалить окончательно">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <button class="bi bi-trash3"
                                @onclick="@(() => DeleteAction(cabinet, true))"
                                title="Перенести в корзину">
                        </button>
                    }
                </td>
                <td>
                    @if (cabinet.ChangeLogs != null)
                    {
                        <i class="bi bi-info-circle" title="@GetChangeLog(cabinet.ChangeLogs)"></i>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<button class="btn btn-primary mb-3" @onclick="AddNewCabinet">Добавить кабинет</button>

<EditCabinetDialog ViewModel="EditModel" Save="SaveChanges" Reload="HandleReload"></EditCabinetDialog>
<DeleteCabinetDialog ViewModel="DeleteModel" ConfirmDelete="ConfirmDelete"></DeleteCabinetDialog>
<ErrorDialog IsOpen="@IsOpenErrorDialog" Message="@ErrorMessage" OnClose="@CloseErrorDialog" />

@code {

}
